{
  "info": {
    "name": "EuroBas Marketplace API v1",
    "description": "Complete API collection for EuroBas classified ads marketplace.\n\nBase URL: https://eurobas.com/api/v1\n\nAuthentication: Bearer token (Passport OAuth2)\n- Tokens expire after 7 days\n- Use POST /auth/refresh to get a new token\n- Use POST /auth/logout to revoke the current token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "https://eurobas.com/api/v1"},
    {"key": "token", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {"raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"]},
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"account_type\": \"individual\",\n  \"agree\": true,\n  \"password\": \"SecurePass1\",\n  \"password_confirmation\": \"SecurePass1\"\n}"}
          }
        },
        {
          "name": "Login",
          "event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();", "if (json.token) { pm.collectionVariables.set('token', json.token); }"]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {"raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"]},
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"SecurePass1\"\n}"}
          }
        },
        {
          "name": "Refresh Token",
          "event": [{"listen": "test", "script": {"exec": ["var json = pm.response.json();", "if (json.token) { pm.collectionVariables.set('token', json.token); }"]}}],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"]}
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {"raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"]}
          }
        },
        {
          "name": "Social Login",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": {"raw": "{{base_url}}/auth/social-login", "host": ["{{base_url}}"], "path": ["auth", "social-login"]},
            "body": {"mode": "raw", "raw": "{\n  \"token\": \"oauth_token\",\n  \"unique_id\": \"provider_id\",\n  \"email\": \"user@example.com\",\n  \"medium\": \"google\"\n}"}
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/forgot-password", "host": ["{{base_url}}"], "path": ["auth", "forgot-password"]},
            "body": {"mode": "raw", "raw": "{\n  \"identity\": \"user@example.com\"\n}"}
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/verify-otp", "host": ["{{base_url}}"], "path": ["auth", "verify-otp"]},
            "body": {"mode": "raw", "raw": "{\n  \"identity\": \"user@example.com\",\n  \"otp\": \"1234\"\n}"}
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "PUT",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/reset-password", "host": ["{{base_url}}"], "path": ["auth", "reset-password"]},
            "body": {"mode": "raw", "raw": "{\n  \"identity\": \"user@example.com\",\n  \"otp\": \"1234\",\n  \"password\": \"NewPass123\",\n  \"confirm_password\": \"NewPass123\"\n}"}
          }
        },
        {
          "name": "Check Phone",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/check-phone", "host": ["{{base_url}}"], "path": ["auth", "check-phone"]},
            "body": {"mode": "raw", "raw": "{\n  \"temporary_token\": \"token_from_register\",\n  \"phone\": \"+31612345678\"\n}"}
          }
        },
        {
          "name": "Verify Phone",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/verify-phone", "host": ["{{base_url}}"], "path": ["auth", "verify-phone"]},
            "body": {"mode": "raw", "raw": "{\n  \"temporary_token\": \"token_from_register\",\n  \"phone\": \"+31612345678\",\n  \"otp\": \"1234\"\n}"}
          }
        },
        {
          "name": "Check Email",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/check-email", "host": ["{{base_url}}"], "path": ["auth", "check-email"]},
            "body": {"mode": "raw", "raw": "{\n  \"temporary_token\": \"token_from_register\",\n  \"email\": \"user@example.com\"\n}"}
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}, {"key": "Content-Type", "value": "application/json"}],
